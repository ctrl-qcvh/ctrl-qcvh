<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Genetic Algorithm Binary String</title>
  <style>
    body { font-family: sans-serif; padding: 20px; }
    #output { margin-top: 10px; font-size: 1.2em; }
  </style>
</head>
<body>
  <h3>Genetic Algorithm Binary String</h3>
  <label>
    Fitness bias (-1.0000 to 1.0000): 
    <input id="slider" type="range" min="-1" max="1" step="0.0001" value="0">
    <span id="sliderVal">0.0000</span>
  </label>
  
  <div id="output"></div>
  <button id="evolveBtn">Evolve</button>

  <script>
    // --- Parameters ---
    const STR_LEN = 16;       // binary string length
    const POP_SIZE = 50;      // population size
    const MUT_RATE = 0.05;    // mutation rate

    // --- Load or init binary string ---
    let bestString = localStorage.getItem("binaryString");
    if (!bestString) {
      bestString = randomBinaryString(STR_LEN);
      localStorage.setItem("binaryString", bestString);
    }

    const slider = document.getElementById("slider");
    const sliderVal = document.getElementById("sliderVal");
    const output = document.getElementById("output");

    sliderVal.textContent = slider.value;

    slider.addEventListener("input", () => {
      sliderVal.textContent = parseFloat(slider.value).toFixed(4);
    });

    function randomBinaryString(len) {
      return Array.from({length: len}, () => Math.random() < 0.5 ? "0" : "1").join("");
    }

    function mutate(str) {
      return str.split("").map(ch => 
        Math.random() < MUT_RATE ? (ch === "0" ? "1" : "0") : ch
      ).join("");
    }

    function crossover(a, b) {
      const point = Math.floor(Math.random() * a.length);
      return a.slice(0, point) + b.slice(point);
    }

    // Fitness: influenced by slider (-1 → prefer zeros, 1 → prefer ones)
    function fitness(str, bias) {
      const ones = str.split("").filter(x => x === "1").length;
      const zeros = str.length - ones;
      return bias >= 0 ? ones * bias : zeros * -bias;
    }

    function evolve() {
      const bias = parseFloat(slider.value);
      let population = Array.from({length: POP_SIZE}, () => randomBinaryString(STR_LEN));
      population[0] = bestString; // keep best so far

      for (let gen = 0; gen < 50; gen++) {
        // evaluate fitness
        const scored = population.map(str => ({ str, score: fitness(str, bias) }));
        scored.sort((a, b) => b.score - a.score);
        bestString = scored[0].str;

        // breed new population
        const newPop = [bestString]; // elitism
        while (newPop.length < POP_SIZE) {
          const parentA = scored[Math.floor(Math.random() * POP_SIZE / 2)].str;
          const parentB = scored[Math.floor(Math.random() * POP_SIZE / 2)].str;
          let child = crossover(parentA, parentB);
          child = mutate(child);
          newPop.push(child);
        }
        population = newPop;
      }

      localStorage.setItem("binaryString", bestString);
      output.textContent = `Best Binary String: ${bestString}`;
    }

    document.getElementById("evolveBtn").addEventListener("click", evolve);

    // Show initial state
    output.textContent = `Best Binary String: ${bestString}`;
  </script>
</body>
</html>










